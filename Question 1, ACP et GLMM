library(glmmTMB)
library(dplyr)
library(purrr)
library(tibble)

# Liste des traits à analyser
# ---------------------------
traits <- c("SLA","L_Mg","L_K","L_P","L_S","L_TMS",
            "SRL","R_TD","R_Diam","R_Mg","R_K","R_P")

# Fonction ajustant un modèle pour un trait
# -----------------------------------------
fit_trait_model <- function(trait_name, data = SCORES) {
  formula_trait <- as.formula(
    paste0(
      trait_name,
      " ~ PC1 + PC2 + CIRC + (1 | SP)" ## changer les variables explicatives au choix
    )
  )
  glmmTMB(
    formula = formula_trait,
    data = data,
    family = gaussian()
  )
}

# Ajuster tous les modèles
# ------------------------
models_traits <- traits |>
  set_names() |>
  map(
    ~ fit_trait_model(
      trait_name = .x,
      data = SCORES
    )
  )
# n d'observations et nombre d'especes reellement utilises par chaque GLMM
sapply(models_traits, nobs)                               # n par trait
sapply(models_traits, function(m) length(unique(m$frame$SP)))   # nb d'especes
# Exemple : résumé du modèle du SLA
#summary(models_traits$SLA)

# Fonction extrayant PC1 et PC2
# ------------------------------
extract_PC_results <- function(model, trait_name) {
  coef_table <- summary(model)$coefficients$cond |>
    as.data.frame() |>
    rownames_to_column("Predictor")
  coef_table |>
    filter(Predictor %in% c("PC1", "PC2")) |>
    transmute(
      Trait = trait_name,
      Predictor,
      Estimate = Estimate,
      SE = `Std. Error`,
      z_value = `z value`,
      p_value = `Pr(>|z|)`,
      CI_low = Estimate - 1.96 * SE,
      CI_high = Estimate + 1.96 * SE,
      Significance = case_when(
        p_value < 0.001 ~ "***",
        p_value < 0.01  ~ "**",
        p_value < 0.05  ~ "*",
        p_value < 0.10  ~ ".",
        TRUE            ~ "ns"
      )
    )
}

# Tableau long des résultats
# --------------------------
RESULTS <- imap_dfr(
  models_traits,
  extract_PC_results
)
RESULTS
