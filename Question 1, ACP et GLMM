# GLMM AUTOMATIQUES POUR TOUS LES TRAITS
# Effets de chaque variable édaphique
#-------------------------------------------------------------
library(dplyr)
library(ggplot2)

## Création d'un nouvel objet "RESULTS2" reprenant les coefficients des
## effet de chaque variable édaphique sur chaque trait
#----------------------------------------------------------------------
RESULTS2 = as.data.frame(matrix(ncol=ncol(SOIL3),nrow=ncol(TRAITS3)))
colnames(RESULTS2) = colnames(SOIL3)
rownames(RESULTS2) = colnames(TRAITS3)
head(RESULTS2) ; dim(RESULTS2)

i=1;j=1
for(i in 1:ncol(SOIL3)){  ## pour chaque variable édaphique...
  title.x = colnames(SOIL3)[i]
  X = SOIL3[,i]
  for(j in 1:ncol(TRAITS3)){  ## pour chaque trait...
    title.y = colnames(TRAITS3)[j]
    Y = TRAITS3[,j]
    MAT = as.data.frame(cbind(Y,X,SCORES$CIRC,SCORES$SP,SCORES$IND))
    colnames(MAT) = c(title.y,title.x,"CIRC","SP","IND")
    MAT[,1] = as.numeric(MAT[,1])
    MAT[,2] = as.numeric(MAT[,2])
    MAT[,3] = as.numeric(MAT[,3])
    MAT[,4] = as.factor(MAT[,4])
    MAT[,5] = as.factor(MAT[,5])
    GLMM = glmmTMB(
      #Y ~ X + CIRC + (1 | SP/IND),
      Y ~ X + CIRC + (1 | SP),
      data = MAT,
      family = gaussian())
    SUMMARY = summary(GLMM)
    RESULTS2[j,i] = round(SUMMARY$coefficients$cond[2,1],3)
    sign=""
    if(SUMMARY$coefficients$cond[2,4]<=0.1) {sign="."}
    if(SUMMARY$coefficients$cond[2,4]<=0.05) {sign="*"}
    if(SUMMARY$coefficients$cond[2,4]<=0.01) {sign="**"}
    if(SUMMARY$coefficients$cond[2,4]<=0.001){sign="***"}
    RESULTS2[j,i] = paste0(RESULTS2[j,i],sign)
  }
}

