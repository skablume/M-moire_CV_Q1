  amult <- 0.9 * max(abs(sco[, 1:2])) / max(abs(rload[, 1:2]))   # fleches a l'echelle du nuage
  Ar    <- rload[, 1:2] * amult
  lim   <- max(abs(rbind(sco[, 1:2], Ar))) * 1.1
  
  plot(sco[, 1:2], asp = 1, xlim = c(-lim, lim), ylim = c(-lim, lim),
       pch = 21, cex = 1.4, bg = col.stat[as.character(grp)],
       xlab = lab[1], ylab = lab[2],
       main = paste("ACP especes + traits", if (rot) "- varimax" else "- sans rotation"))
  abline(h = 0, v = 0, lty = 2, col = "grey60")
  ordiellipse(sco[, 1:2], grp, col = col.stat[levels(grp)], lwd = 2) #ellipses a 1 ecart-type
  # ordiellipse(sco[, 1:2], grp, kind = "sd", conf = 0.95, col = col.stat[levels(grp)], lwd = 2) #ellipses a 95%
  
  #Paragraphe similaire à celui en dessous, mais n'empêchant pas le chevauchement des étiquettes
  # arrows(0, 0, Ar[fol, 1], Ar[fol, 2], length = 0.08, col = COL_FOL, lwd = 1.6)
  # text(Ar[fol, 1], Ar[fol, 2], etiqueter(fol), col = "forestgreen", pos = 3, cex = 0.8, font = 2)
  # arrows(0, 0, Ar[rac, 1], Ar[rac, 2], length = 0.08, col = COL_RAC, lwd = 1.6)
  # text(Ar[rac, 1], Ar[rac, 2], etiqueter(rac), col = "firebrick", pos = 3, cex = 0.8, font = 2)
  
  ## --- fleches ---
  arrows(0, 0, Ar[fol, 1], Ar[fol, 2], length = 0.08, col = COL_FOL, lwd = 1.6)
  arrows(0, 0, Ar[rac, 1], Ar[rac, 2], length = 0.08, col = COL_RAC, lwd = 1.6)
  ## --- étiquettes, mais empêchant le chevauchement ---
  xy    <- rbind(Ar[fol, 1:2], Ar[rac, 1:2])
  lab.t <- c(etiqueter(fol), etiqueter(rac))
  col.t <- c(rep(COL_FOL, length(fol)), rep(COL_RAC, length(rac)))
  thigmophobe.labels(xy[, 1], xy[, 2], labels = lab.t, col = col.t, cex = 0.8, font = 2)
  
  legend("topright", bty = "n", cex = 0.8,
         legend = c("Traits foliaires", "Traits racinaires", "Indigene", "Exotique"),
         lty = c(1, 1, NA, NA), lwd = c(2, 2, NA, NA), pch = c(NA, NA, 21, 21),
         col = c(COL_FOL, COL_RAC, "black", "black"),
         pt.bg = c(NA, NA, col.stat))
}
}





## ============================================================================
## B6. MATRICES DE CORRELATION avec correction (echelle individu, jeu complet)
## ============================================================================
PALETTE <- colorRampPalette(c("#0072B2", "white", "#E69F00"))(200)

jeu  <- "complet"
vars <- c(JEUX[[jeu]]$fol, JEUX[[jeu]]$rac)
COR  <- preparer(IND, vars)
colnames(COR) <- etiqueter(colnames(COR))
res  <- rcorr(as.matrix(COR), type = "pearson")

fl <- etiqueter(JEUX[[jeu]]$fol)
rc <- etiqueter(JEUX[[jeu]]$rac)

## ---------------------------------------------------------------------------
## Correction 1 : sur l'ensemble des paires uniques de la matrice
## ---------------------------------------------------------------------------
idx   <- upper.tri(res$P)
q_all <- p.adjust(res$P[idx], method = "BH")
Q_all <- matrix(NA, nrow(res$P), ncol(res$P), dimnames = dimnames(res$P))
Q_all[idx] <- q_all
Q_all[lower.tri(Q_all)] <- t(Q_all)[lower.tri(Q_all)]
diag(Q_all) <- 0

## ---------------------------------------------------------------------------
## Correction 2 : sur le seul bloc foliaire x racinaire
## ---------------------------------------------------------------------------
P_bloc <- res$P[fl, rc, drop = FALSE]
P_bh   <- matrix(p.adjust(as.vector(P_bloc), method = "BH"),
                 nrow = nrow(P_bloc), dimnames = dimnames(P_bloc))

## --- Sorties console ---
cat("\n===== MATRICE COMPLETE =====\n")
cat("paires uniques testees         :", sum(idx), "\n")
cat("significatives (p brut < 0,05) :", sum(res$P[idx] < 0.05, na.rm = TRUE),
    sprintf("| attendu par hasard : %.1f\n", sum(idx) * 0.05))
cat("significatives (BH < 0,05)     :", sum(q_all < 0.05, na.rm = TRUE), "\n")

cat("\n===== BLOC FOLIAIRE x RACINAIRE =====\n")
cat("paires testees                 :", sum(!is.na(P_bloc)), "\n")
cat("significatives (p brut < 0,05) :", sum(P_bloc < 0.05, na.rm = TRUE),
    sprintf("| attendu par hasard : %.1f\n", sum(!is.na(P_bloc)) * 0.05))
cat("significatives (BH < 0,05)     :", sum(P_bh < 0.05, na.rm = TRUE), "\n\n")
cat("-- coefficients r --\n");    print(round(res$r[fl, rc], 2))
cat("\n-- p brutes --\n");        print(round(P_bloc, 3))
cat("\n-- p ajustees (BH) --\n"); print(round(P_bh, 3))

## ---------------------------------------------------------------------------
## FIGURES
## ---------------------------------------------------------------------------

