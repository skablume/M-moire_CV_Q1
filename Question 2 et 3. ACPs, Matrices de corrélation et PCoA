## ============================================================================
## C. Question 3 - indigenes vs exotiques dans l'espace fonctionnel
##    Echelle espece, traits selectionnes, sans rotation.
##    (1) ACP + PERMANOVA, distance euclidienne
##    (2) PCoA + PERMANOVA, distance de Gower (Borcard et al. 2018, sect. 5.5)
## ============================================================================
ESP$Statut <- IND$Statut[match(ESP$SP_code, IND$SP_code)]
vars    <- c(fol_select, rac_select)
keep    <- complete.cases(ESP[, vars])
grp     <- factor(ESP$Statut[keep])
col.grp <- c(Indigene = COL_IND, Exotique = COL_EXO)
table(grp)                                     # attendu : 17 indigenes / 12 exotiques

## ------------------------------------------------------------------ (1) ACP
Y   <- preparer(ESP, vars)                     # Box-Cox + standardise
pca <- rda(Y)
eig <- 100 * pca$CA$eig / sum(pca$CA$eig)
sit <- scores(pca, display = "sites", choices = 1:2, scaling = 1)

plot(sit, asp = 1, pch = 21, cex = 1.3, bg = col.grp[as.character(grp)],
     xlab = paste0("PC1 (", round(eig[1], 1), " %)"),
     ylab = paste0("PC2 (", round(eig[2], 1), " %)"),
     main = "ACP : indigenes vs exotiques")
abline(h = 0, v = 0, lty = 3, col = "grey60")
ordiellipse(sit, grp, col = col.grp[levels(grp)], lwd = 2)   # 1 ecart-type
legend("topright", names(col.grp), pch = 21, pt.bg = col.grp, bty = "n")

## Test : difference de position ? (distance euclidienne)
eucl <- dist(Y)
(adonis2(eucl ~ grp, permutations = 9999))
permutest(betadisper(eucl, grp), permutations = 9999)

## ----------------------------------------------------------------- (2) PCoA
gow  <- vegdist(ESP[keep, vars], method = "gower")
pcoa <- cmdscale(gow, k = nrow(Y) - 1, eig = TRUE)
pct  <- 100 * pcoa$eig[1:2] / sum(pcoa$eig[pcoa$eig > 0])
sco  <- pcoa$points[, 1:2]

plot(sco, asp = 1, pch = 21, cex = 1.3, bg = col.grp[as.character(grp)],
     xlab = paste0("PCoA 1 (", round(pct[1], 1), " %)"),
     ylab = paste0("PCoA 2 (", round(pct[2], 1), " %)"),
     main = "PCoA (Gower) - indigenes vs exotiques")
abline(h = 0, v = 0, lty = 3, col = "grey60")
ordiellipse(sco, grp, col = col.grp[levels(grp)], lwd = 2)   # 1 ecart-type
legend("topright", names(col.grp), pch = 21, pt.bg = col.grp, bty = "n")

## Projection a posteriori des traits
Y_lab <- Y
colnames(Y_lab) <- etiqueter(colnames(Y_lab))
(trait.ef <- envfit(pcoa, Y_lab, permutations = 999))
plot(trait.ef, col = "grey20", cex = 0.8)

## ------------------------------------------------------------- Recapitulatif
cat("\n--- PERMANOVA euclidienne (ACP) ---\n"); print(adonis2(eucl ~ grp, permutations = 9999))
cat("\n--- betadisper euclidien ---\n");        print(permutest(betadisper(eucl, grp), permutations = 9999))
