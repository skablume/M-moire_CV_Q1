)
## Les concentrations racinaires (R_K, R_Mg...) gardent leur nom car déja lisibles.

## --- Fonction de traduction --------------------------------------------
##  Pour le sol : on retire le prefixe "S_".
##  L'absence de prefixe devient le marqueur d'une variable edaphique.
##      S_pH -> pH     S_Al -> Al     S_Mg -> Mg

etiqueter <- function(v) {
  out <- unname(ETIQUETTES[v])
  manquants <- is.na(out)
  out[manquants] <- sub("^S_", "", v[manquants])
  out
}

