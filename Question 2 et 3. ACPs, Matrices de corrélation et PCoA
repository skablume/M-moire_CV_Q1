## Pareil que ci-dessus mais pour B5.
preparer <- function(tab, vars) {
  stopifnot(all(vars %in% names(tab)))
  M <- tab[, vars, drop = FALSE]
  M <- M[complete.cases(M), , drop = FALSE]
  for (i in seq_len(ncol(M))) {
    lam <- BoxCox.lambda(M[, i] + abs(min(M[, i])) + 1e-10,
                         method = "loglik", lower = -3, upper = 3)
    M[, i] <- BoxCox(M[, i], lambda = lam)
  }
  as.data.frame(decostand(M, "standardize"))
}


## B4. ACP, flèches rouges et vertes
## =================================

acp_biplot <- function(M, vars_fol, vars_rac, titre, fichier,
                       varimax_rot = TRUE, a = 1, b = 2) {
  
  pca  <- rda(M)
  eigs <- pca$CA$eig / sum(pca$CA$eig) * 100
  load <- vegan::scores(pca, choices = c(a, b))$species
  
  if (varimax_rot) {
    rload <- unclass(varimax(load)$loadings)   # unclass : redevient une matrice
    ## Apres rotation, la variance est redistribuee entre les 2 axes retenus :
    ## les valeurs propres d'origine ne s'appliquent plus telles quelles.
    part_rel <- colSums(rload^2) / sum(colSums(rload^2))   # part relative dans le plan
    part     <- part_rel * sum(eigs[c(a, b)])              # rapportee au total du plan
    stopifnot(abs(sum(part) - sum(eigs[c(a, b)])) < 1e-8)
    lab  <- c(paste0("PC", a, " varimax (", round(part[1], 1), "%)"),
              paste0("PC", b, " varimax (", round(part[2], 1), "%)"))
  } else {
    rload <- load
    lab   <- c(paste0("PC", a, " (", round(eigs[a], 1), "%)"),
               paste0("PC", b, " (", round(eigs[b], 1), "%)"))
  }
  
  fol     <- intersect(vars_fol, rownames(rload))
  rac     <- intersect(vars_rac, rownames(rload))
  lim     <- max(abs(rload[, 1:2])) * 1.25
  cex_lab <- if (nrow(rload) > 15) 0.60 else 0.85
  
  dessiner <- function() {
    par(mar = c(4.5, 4.5, 3.5, 1))
    plot(NA, xlim = c(-lim, lim), ylim = c(-lim, lim), asp = 1,
         xlab = lab[1], ylab = lab[2], main = titre,
         cex.lab = 1.1, cex.main = 1.05)
    abline(h = 0, v = 0, lty = 2, col = "grey60")
    
    ## Etiquettes traduites au moment de dessiner : les noms internes
    ## des colonnes ne changent jamais.
    arrows(0, 0, rload[fol, 1], rload[fol, 2], length = 0.08, col = COL_FOL, lwd = 1.6)
    text(rload[fol, 1], rload[fol, 2], labels = etiqueter(fol), col = COL_FOL, pos = 3, cex = cex_lab, font = 2)
    
    arrows(0, 0, rload[rac, 1], rload[rac, 2], length = 0.08, col = COL_RAC, lwd = 1.6)
    text(rload[rac, 1], rload[rac, 2], labels = etiqueter(rac), col = COL_RAC, pos = 3, cex = cex_lab, font = 2)
    
    legend("topright", legend = c("Traits foliaires", "Traits racinaires"),
           col = c(COL_FOL, COL_RAC), lty = 1, lwd = 2, bty = "n", cex = 0.9)
    mtext(paste0("n = ", nrow(M), " | ", ncol(M), " traits"),
          side = 1, line = 3.2, adj = 1, cex = 0.75, col = "grey40")
  }
  
  dessiner()
  invisible(list(pca = pca, loadings = rload, eigs = eigs))
}


